# LLM provider: "claude" or "ollama"
LLM_PROVIDER=claude

# Claude (Anthropic) — required when LLM_PROVIDER=claude
CLAUDE_API_KEY=sk-ant-replace-me
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Ollama — required when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=aya:8b

# Path to the v3.x TadqeeqAI repo on disk — used to locate
# chroma_db_v2/, bm25_index.pkl, documents.json, clauses.json.
# Override in prod to point at a mounted data volume.
TADQEEQ_DATA_DIR=../TadqeeqAI

# CORS — comma-separated origins for the web frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
